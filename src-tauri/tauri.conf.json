{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blueprint IDE",
  "version": "0.1.0",
  "identifier": "local.blueprint.ide",
  "build": {
    "beforeDevCommand": "npm run desktop:dev:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Blueprint IDE",
        "width": 760,
        "height": 420,
        "minWidth": 720,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/desktop-blueprint-bridge.cjs": "scripts/desktop-blueprint-bridge.cjs",
      "../dist/shared/": "dist/shared/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
