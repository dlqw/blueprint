{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint Graph",
  "type": "object",
  "required": ["format", "version", "id", "name", "description", "nodes", "links", "layout"],
  "properties": {
    "format": { "const": "blueprint-graph" },
    "version": { "const": 1 },
    "kind": { "enum": ["function", "macro"] },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "templateMetadata": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "properties": {
        "creationPath": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDefinition" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDefinition" }
        }
      },
      "additionalProperties": true
    },
    "localTemplates": {
      "type": "array",
      "items": { "$ref": "#/$defs/nodeTemplate" }
    },
    "embeddedGraphs": {
      "type": "array",
      "items": { "$ref": "#" }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "templateId", "position", "inputBindings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "templateId": { "type": "string", "minLength": 1 },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "inputBindings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["portId", "sourceKind"],
              "properties": {
                "portId": { "type": "string", "minLength": 1 },
                "sourceKind": { "enum": ["literal", "link"] },
                "literalValue": {},
                "linkId": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "controlBindings": { "type": "object" },
          "displayOverrides": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fromNodeId", "fromPortId", "toNodeId", "toPortId", "flowKind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fromNodeId": { "type": "string", "minLength": 1 },
          "fromPortId": { "type": "string", "minLength": 1 },
          "toNodeId": { "type": "string", "minLength": 1 },
          "toPortId": { "type": "string", "minLength": 1 },
          "flowKind": { "enum": ["data", "control"] },
          "contextVariableId": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "position", "size", "nodeIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "size": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "number", "minimum": 120 },
              "height": { "type": "number", "minimum": 80 }
            }
          },
          "nodeIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "color": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "position"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "nodeId": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "debug": {
      "type": "object",
      "properties": {
        "breakpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId"],
            "properties": {
              "nodeId": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" },
              "condition": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["viewport"],
      "properties": {
        "viewport": {
          "type": "object",
          "required": ["x", "y", "zoom"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number" }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nodeTemplate": {
      "type": "object",
      "required": ["id", "name", "creationPath", "description", "inputs", "outputs", "controlInputs", "controlOutputs", "bodyKind", "bodyRef"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "creationPath": { "type": "string" },
        "description": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDefinition" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDefinition" }
        },
        "controlInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDefinition" }
        },
        "controlOutputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portDefinition" }
        },
        "bodyKind": { "enum": ["typescriptFunction", "typescriptBuiltin", "blueprintGraph", "macroExpansion"] },
        "bodyRef": { "type": "string" },
        "i18n": { "$ref": "#/$defs/templateI18n" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "templateI18n": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "creationPath": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": { "$ref": "#/$defs/localizedText" },
              "description": { "$ref": "#/$defs/localizedText" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "portDefinition": {
      "type": "object",
      "required": ["id", "name", "direction", "flowKind", "type", "description", "editor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output"] },
        "flowKind": { "enum": ["data", "control"] },
        "type": { "enum": ["exec", "string", "number", "boolean", "bigint", "null", "undefined", "json", "unknown"] },
        "description": { "type": "string" },
        "editor": { "enum": ["text", "number", "boolean", "select", "json", "none"] },
        "defaultValue": {},
        "constraints": {
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "type": ["string", "number", "boolean"]
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
